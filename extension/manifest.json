{
  "manifest_version": 3,
  "name": "gh-lightbox",
  "version": "0.1.0",
  "description": "Opens images and videos from GitHub issues and pull requests in a lightbox on the same page.",
  "minimum_chrome_version": "132",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["loader.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*"],
      "matches": ["https://github.com/*"]
    }
  ]
}
