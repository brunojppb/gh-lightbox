{
  "manifest_version": 3,
  "name": "Lightbox for GitHub",
  "short_name": "gh-lightbox",
  "version": "0.1.1",
  "description": "Opens images and videos from GitHub issues and pull requests in a lightbox on the same page.",
  "homepage_url": "https://github.com/brunojppb/gh-lightbox",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "132",
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
