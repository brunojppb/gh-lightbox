{
  "compilerOptions": {
    "target": "es2023",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "exactOptionalPropertyTypes": true
  },
  "include": ["extension/**/*.js", "types/**/*.d.ts", "test/**/*.js", "scripts/**/*.mjs"]
}
